{
  "name": "syncra",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "cross-env WS_NO_BUFFER_UTIL=1 next dev --webpack",
    "build": "cross-env WS_NO_BUFFER_UTIL=1 next build --webpack",
    "start": "cross-env WS_NO_BUFFER_UTIL=1 next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "npx playwright test",
    "test:pipeline": "node --test tests/briefing-pipeline.test.ts tests/security-migrations.test.ts tests/whatsapp-disconnect-policy.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug"
  },
  "dependencies": {
    "@insforge/sdk": "^1.4.3",
    "@playwright/test": "^1.61.1",
    "@trigger.dev/sdk": "4.5.4",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "openai": "^6.46.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "4.5.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "engine.io": "^6.6.9",
    "engine.io-client": "^6.6.6",
    "socket.io-parser": "^4.2.7"
  }
