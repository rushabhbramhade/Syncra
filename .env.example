# InsForge platform
NEXT_PUBLIC_INSFORGE_BASE_URL=https://<project>.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
INSFORGE_API_KEY=ik_...

# App URL (Vercel sets VERCEL_URL at runtime)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption / OAuth state signing
TOKEN_ENCRYPTION_KEY=<64-hex-chars>

# ── AI model gateway ─────────────────────────────────────────────
# The gateway routes by TASK on NVIDIA NIM first, falling back to
# OpenRouter. At least one key is required; NVIDIA is the primary.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional per-task NVIDIA model overrides (defaults are built-in per task and
# verified live 2026-08-09 — the chat default changed after deepseek-v4-pro EOL'd):
# NVIDIA_MODEL_HEAVY=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL_FAST=minimaxai/minimax-m3
# NVIDIA_MODEL_CODE=minimaxai/minimax-m3
# NVIDIA_MODEL_CHAT=minimaxai/minimax-m3
# OpenRouter fallback (required if NVIDIA is unused). OPENROUTER_MODEL is the
# legacy single-model fallback. NOTE: old defaults deepseek/deepseek-chat-v3
# returns HTTP 402 once the OpenRouter credit balance runs low; the built-in
# chain prefers openai/gpt-4o-mini. Set OPENROUTER_MODEL_<TASK> to re-point.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_...

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Postgres connection for migration scripts (run-migrations.mjs, check-db.mjs)
DATABASE_URL=postgresql://postgres:<password>@<project>.ap-southeast.database.insforge.app:5432/insforge?sslmode=require
