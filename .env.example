# InsForge platform
NEXT_PUBLIC_INSFORGE_BASE_URL=https://<project>.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
INSFORGE_API_KEY=ik_...

# App URL (Vercel sets VERCEL_URL at runtime)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption / OAuth state signing
TOKEN_ENCRYPTION_KEY=<64-hex-chars>

# AI model gateway
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_...

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Postgres connection for migration scripts (run-migrations.mjs, check-db.mjs)
DATABASE_URL=postgresql://postgres:<password>@<project>.ap-southeast.database.insforge.app:5432/insforge?sslmode=require
